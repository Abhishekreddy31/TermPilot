{
  "name": "@abhishekreddy31/term-pilot",
  "version": "1.1.0",
  "description": "Control your laptop's terminal from your phone. Voice commands, multi-session tabs, tmux mirroring, remote access.",
  "license": "MIT",
  "author": "Abhishek Reddy <abhisheksingireddy31@gmail.com> (https://github.com/Abhishekreddy31)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhishekreddy31/TermPilot.git"
  },
  "homepage": "https://github.com/Abhishekreddy31/TermPilot#readme",
  "bugs": {
    "url": "https://github.com/Abhishekreddy31/TermPilot/issues"
  },
  "keywords": [
    "terminal",
    "remote-terminal",
    "pwa",
    "voice-control",
    "tmux",
    "xterm",
    "websocket",
    "mobile",
    "developer-tools",
    "node-pty",
    "cloudflare-tunnel",
    "cli"
  ],
  "bin": {
    "term-pilot": "dist/cli.js"
  },
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "pnpm --filter @termpilot/shared build && pnpm -r --parallel --filter @termpilot/server --filter @termpilot/client run dev",
    "dev:server": "pnpm --filter @termpilot/server dev",
    "dev:client": "pnpm --filter @termpilot/client dev",
    "build": "node scripts/build-publish.js",
    "start": "pnpm run build && node dist/cli.js",
    "test": "vitest run --project unit:node --project unit:client --project integration",
    "test:unit": "vitest run --project unit:node --project unit:client",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit:node --project unit:client --project integration --coverage",
    "test:watch": "vitest --project unit:node --project unit:client --project integration",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @termpilot/shared build && pnpm -r run typecheck && tsc -p tests/tsconfig.json",
    "audit": "pnpm audit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "pnpm -r run clean && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "node scripts/build-publish.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "dependencies": {
    "node-pty": "1.2.0-beta.18",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "preact": "^11.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.4.2",
  "publishConfig": {
    "access": "public"
  }
}
